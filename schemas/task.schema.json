{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exam Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "question_id",
    "stage",
    "base_commit",
    "skill_ref",
    "input_manifest_hash",
    "required_files",
    "instructions",
    "output_schema"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "design",
        "input",
        "material_review",
        "output_build",
        "quality_review",
        "scoring"
      ]
    },
    "base_commit": { "type": "string", "minLength": 1 },
    "skill_ref": { "type": "string", "minLength": 1 },
    "input_manifest_hash": { "type": "string" },
    "required_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "instructions": { "type": "string", "minLength": 1 },
    "output_schema": { "type": "string", "minLength": 1 }
  }
}
